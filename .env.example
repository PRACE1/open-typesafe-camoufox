# LLM planner (Groq OpenAI-compatible, mirrors video-agent)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Writer/proposer model (any OpenAI-compatible endpoint; overrides GROQ_* when set)
WRITER_API_KEY=
WRITER_BASE_URL=
WRITER_MODEL=
# WRITER_API: chat (default, /chat/completions) or response (/responses, e.g. Muse Spark on OpenCode Go)
WRITER_API=
# Jev decider (TypeSafe System One)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
# Task credentials (copy to .env.local and fill in)
TWITTER_USERNAME=
TWITTER_PASSWORD=
