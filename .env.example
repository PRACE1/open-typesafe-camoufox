# LLM planner (Groq OpenAI-compatible, mirrors video-agent)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Writer/proposer model (any OpenAI-compatible endpoint; overrides GROQ_* when set)
WRITER_API_KEY=
WRITER_BASE_URL=
WRITER_MODEL=
# WRITER_API: chat (default, /chat/completions), response (/responses, e.g. Muse Spark on OpenCode Go),
# or messages (Anthropic Messages protocol, e.g. union-alpha free on OpenCode Go)
WRITER_API=
# Jev decider (TypeSafe System One)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
# Task credentials (copy to .env.local and fill in)
TWITTER_USERNAME=
TWITTER_PASSWORD=
# 2captcha paid-solve backend + residential proxy (copy to .env.local and
# fill in; never commit — secrets stay in .env.local only)
APIKEY_2CAPTCHA=
TWOCAPTCHA_PROXY_TYPE=
TWOCAPTCHA_PROXY_HOST=
TWOCAPTCHA_PROXY_PORT=
TWOCAPTCHA_PROXY_USER=
TWOCAPTCHA_PROXY_PASS=
# CaptchaKraken vision grid solver (optional BYOK backend; never commit —
# put the live key in .env.local only, and rotate any key pasted in chat)
# VLLM_BASE_URL defaults to https://api.captchakraken.com/v1 when unset
CAPTCHA_KRAKEN_API_KEY=
VLLM_BASE_URL=
# Jina Reader + Reranker for structured page memory (copy to .env.local;
# never commit — Reader works anonymously at 20 RPM without a key)
JINA_API_KEY=
